# ===========================================================================
# ImmersityXR Deployment - Environment Variables
# ===========================================================================
# Copy this file to .env and update with your values
# Command: cp env.example .env
#
# Each variable below is tagged:
#   [REQUIRED]     must be set, or the deployment will not come up correctly
#   [RECOMMENDED]  works if left empty, but leaving it empty is unsafe
#   [OPTIONAL]     has a sensible default; set only to override it
#
# The portal section is enabled only when COMPOSE_PROFILES=portal is
# uncommented; its variables are marked [REQUIRED (portal)] and are ignored
# otherwise.

# [REQUIRED] Domain name (used for Let's Encrypt and routing)
DOMAIN=yourdomain.edu

# [OPTIONAL] Timezone (default: the container's, usually UTC)
TZ=America/Chicago

# [REQUIRED] Let's Encrypt email (for certificate expiration notices)
ACME_EMAIL=admin@yourdomain.edu

# ===========================================================================
# Relay server security
# ===========================================================================
# [REQUIRED] Origins allowed to connect to the relay (Socket.IO CORS),
# space-separated, in host:port form. Include the build server domain and,
# if you deploy the portal, the portal domain.
RELAY_ORIGINS=https://yourdomain.edu:443

# [RECOMMENDED] Shared secret VR clients must present to connect to the relay
# (append &auth=<value> to client launch URLs; the portal sends it
# automatically when VUE_APP_VR_AUTH_TOKEN is set).
# Leave empty to allow unauthenticated clients (NOT recommended).
# NOTE: enforcement requires a relay image with auth support - build it
# from this repository's sources: docker compose build immersity-relay
RELAY_CLIENT_SECRET=

# [RECOMMENDED] Shared secret for the relay /admin diagnostics dashboard.
# With auth-capable relay images, /admin rejects ALL connections while
# this is empty (so the dashboard is simply disabled until you set it).
RELAY_ADMIN_SECRET=


# ===========================================================================
# WebRTC voice/video (relay /rtc namespace)
# ===========================================================================
# [OPTIONAL] STUN servers handed to WebRTC clients (space-separated). The
# default public Google STUN servers are used when left empty.
RTC_STUN_URLS=

# [OPTIONAL] TURN server for participants behind strict NATs (e.g. off-campus
# attendees). Leave empty to skip. Example: turn:turn.yourdomain.edu:3478
# If RTC_TURN_URL is set, its username and credential are required too.
RTC_TURN_URL=
RTC_TURN_USERNAME=
RTC_TURN_CREDENTIAL=

# ===========================================================================
# Session state persistence
# ===========================================================================
# [OPTIONAL] Shared session state (entities, scene, draw strokes) is
# snapshotted to disk so late joiners see previous changes and state survives
# relay restarts. Stored state expires after this many hours (default 168 =
# 7 days). Snapshots live in immersity-relay/sessions/ - back it up along
# with captures.
SESSION_STATE_TTL_HOURS=168

# ===========================================================================
# Web Portal (optional) - see docs/PORTAL.md
# ===========================================================================
# [OPTIONAL] Uncomment the line below to include the portal in
# `docker compose up` and `./deploy.sh`. The portal needs its own DNS records
# (PORTAL_DOMAIN and PORTAL_API_DOMAIN must both point at this server).
# Everything below is [REQUIRED (portal)] only when this is enabled.
#COMPOSE_PROFILES=portal

# [REQUIRED (portal)] Where the user-facing portal is served
PORTAL_DOMAIN=portal.yourdomain.edu

# [REQUIRED (portal)] Where the portal REST API is served
PORTAL_API_DOMAIN=api.yourdomain.edu


# Database credentials for the portal backend (choose strong values;
# the database runs inside the backend container and is not exposed)
# [REQUIRED (portal)] database name and application user
PORTAL_MYSQL_DATABASE=immersity
PORTAL_MYSQL_USER=immersity
# [REQUIRED (portal)] passwords - the backend has no defaults for these
PORTAL_MYSQL_PASSWORD=
PORTAL_MYSQL_ROOT_PASSWORD=

# [REQUIRED (portal)] Initial portal admin account, created the first time the
# database is initialized. The backend entrypoint EXITS if either is empty on
# first init (there is no default password).
PORTAL_ADMIN_EMAIL=admin@yourdomain.edu
PORTAL_ADMIN_PASSWORD=
